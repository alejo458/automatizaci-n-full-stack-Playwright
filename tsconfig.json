{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",

    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@fixtures/*": ["fixtures/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "fixtures",
    "playwright.config.ts"
  ]
}